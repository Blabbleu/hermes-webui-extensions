# btop sidecar — token-v1 loopback backend for the btop WebUI extension.
# Reads /proc and /sys and serves snapshots on 127.0.0.1:17797. WebUI provisions
# the proxy token in the state dir; the scaffold resolves it. No token in this unit.
#
# User unit (sees every process, can signal only your own):
#   cp hermes-btop-sidecar.service ~/.config/systemd/user/
#   systemctl --user enable --now hermes-btop-sidecar
# System unit as root (can signal any process): scripts/install.py --service
#   writes this file to /etc/systemd/system with %h resolved to absolute paths.
# To disable process signals, add a drop-in with Environment=BTOP_SIGNALS=0.
[Unit]
Description=btop sidecar (system monitor backend for the btop WebUI extension, token-v1)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/webui/extensions/btop/sidecar
Environment=HERMES_WEBUI_STATE_DIR=%h/.hermes/webui
ExecStart=/usr/bin/python3 -S -u sidecar.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
