{
  "id": "project-folders",
  "name": "Project Folders",
  "description": "Collapsible project folders for the chat sidebar. Client-side only: reads/writes core project bindings (/api/projects, /api/projects/bind), opens chats and creates sessions through core's own sidebar/new-session paths, regenerates titles via core, and edits HERMES.md via core's file API.",
  "version": "2.0.0",
  "author": "motolight",
  "min_webui_version": "0.52.515",
  "assets": {
    "scripts": [
      "assets/project-folders.js"
    ],
    "stylesheets": [
      "assets/project-folders.css"
    ]
  },
  "capabilities": [
    "manifest-bundle"
  ],
  "lifecycle": {
    "webui_restart_required": false,
    "sidecar_start_required": false,
    "native_host_start_required": false,
    "native_host_autostart": "none"
  },
  "post_install": {
    "summary": "Install enables the folder sidebar. Toggle it with the folder icon in the Chat panel header. Project workspaces are core's own project bindings — shared with core's project quick-create, no sidecar or extra setup needed.",
    "docs_url": "https://github.com/hermes-webui/hermes-webui-extensions/tree/main/extensions/project-folders#readme",
    "requires_local_app": false
  },
  "screenshots": [
    "screenshots/folders-sidebar.png",
    "screenshots/folders-sidebar-light.png",
    "screenshots/mobile-drawer.png",
    "screenshots/row-menu.png",
    "screenshots/hermes-md-dialog.png"
  ],
  "permissions": {
    "webui_api": {
      "read": [
        "sessions",
        "session",
        "/api/projects",
        "/api/file"
      ],
      "write": [
        "/api/session/new",
        "/api/session/move",
        "/api/session/update",
        "/api/session/rename",
        "/api/session/archive",
        "/api/session/delete",
        "/api/session/title/regenerate",
        "/api/projects/bind",
        "/api/projects/rename",
        "/api/projects/delete",
        "/api/file/save"
      ]
    },
    "webui_navigation": true,
    "dom": {
      "owned": true,
      "mutates_core_views": true
    },
    "storage": {
      "owned": [
        "hermes-pf-mode",
        "hermes-pf-collapse"
      ],
      "shared_webui_keys": []
    },
    "loopback_sidecar": false,
    "native_host": false,
    "filesystem": {
      "arbitrary": false,
      "serves_bundled_assets": true
    },
    "network_external": false
  }
}
